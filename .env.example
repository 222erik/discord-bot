# Bot token from the Developer Portal:
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's (guild's) ID for instant slash-command registration.
# Get it from Discord: right-click your server -> Copy Server ID
# (Server Settings -> Advanced must enable Developer Mode).
# Leave empty to register commands globally (can take up to 1 hour to appear).
GUILD_ID=
